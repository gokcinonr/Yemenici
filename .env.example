# ──────────────────────────────────────────────────────────────────────────────
# Yemenici – Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Use the Supabase Transaction Pooler URL (port 6543) for pooled connections.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SUPABASE_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Fallback – only used when SUPABASE_DATABASE_URL is not set.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on.
# Hostinger managed hosting injects this automatically; set it for local runs.
PORT=3000

# Set to "production" for Hostinger. Controls log format & static file serving.
NODE_ENV=production

# Set to "1" when the app sits behind a trusted reverse proxy (Hostinger).
# Enables secure session cookies over HTTPS.
TRUST_PROXY=1

# ── Session & Auth ────────────────────────────────────────────────────────────
# Random string used to sign session cookies. Use a long random value in prod.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# Password for the default admin panel user (set before first deploy).
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# Path prefix for private uploads.
# Format: /bucket-name/optional-prefix
PRIVATE_OBJECT_DIR=/your-gcs-bucket-name/private

# Comma-separated GCS path prefixes to search for public assets.
# Format: /bucket-name/prefix1, /bucket-name/prefix2
PUBLIC_OBJECT_SEARCH_PATHS=/your-gcs-bucket-name/public

# GCS credentials – choose ONE of the two options below:

# Option A: Path to a service-account JSON key file on disk.
#   The service account needs roles: Storage Object Admin + Service Account Token Creator.
# GOOGLE_APPLICATION_CREDENTIALS=/home/user/.config/gcs/service-account.json

# Option B: Inline JSON key (useful on Hostinger where file mounting is awkward).
#   Paste the entire contents of the service-account JSON on one line.
# GCS_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Logging ───────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
