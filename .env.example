# ──────────────────────────────────────────────────────────────────────────────
# Yemenici – Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# TWO DEPLOYMENT TARGETS — choose one set:
#   Replit  : PostgreSQL (SUPABASE_DATABASE_URL) + GCS object storage
#   Hostinger: MySQL (MYSQL_DATABASE_URL) + filesystem storage (UPLOAD_ROOT)
# ──────────────────────────────────────────────────────────────────────────────

# ── Server (required in both environments) ────────────────────────────────────
# Port the Express server listens on. Defaults to 3000 if not set.
# Hostinger injects PORT automatically; set it explicitly for local runs.
PORT=3000

# "production" enables static file serving and structured JSON logs.
NODE_ENV=production

# "1" when the app runs behind a reverse proxy (Hostinger, Replit prod).
# Enables secure session cookies over HTTPS.
TRUST_PROXY=1

# ── Session & Auth (required in both environments) ────────────────────────────
# Random string used to sign session cookies. Use a long random value in prod.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# Password for the default admin panel user (set before first deploy).
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Database — Hostinger runtime (MySQL, internal host) ───────────────────────
# Set this variable to activate MySQL mode in the running application.
# Uses Hostinger's INTERNAL database host (localhost or 127.0.0.1) which is
# only reachable from within the Hostinger server itself.
# When set, @workspace/db-mysql is loaded; PostgreSQL variables are ignored.
# Format: mysql://DB_USER:PASSWORD@localhost:3306/DATABASE_NAME
# MYSQL_DATABASE_URL=mysql://u123456789_yemuser:PASSWORD@localhost:3306/u123456789_yemenici

# ── Database — One-time migration only (MySQL, remote host) ───────────────────
# Used ONLY by the migration script (scripts/src/migrate-to-mysql.ts).
# Uses Hostinger's EXTERNAL/REMOTE hostname so the script can run from
# Replit or a local computer. NEVER use this in the application itself.
# Find the remote host in hPanel → Databases → Remote MySQL.
# Format: mysql://DB_USER:PASSWORD@REMOTE_HOSTINGER_HOST:3306/DATABASE_NAME
# MYSQL_MIGRATION_DATABASE_URL=mysql://u123456789_yemuser:PASSWORD@srv1234.hstgr.io:3306/u123456789_yemenici

# ── Database — Replit (PostgreSQL via Supabase) ───────────────────────────────
# Used when MYSQL_DATABASE_URL is NOT set (Replit environment).
# Supabase Transaction Pooler URL (port 6543) for pooled connections.
# Format: postgresql://USER:PASSWORD@HOST:6543/DATABASE
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Fallback – only used when both MYSQL_DATABASE_URL and SUPABASE_DATABASE_URL
# are absent (Replit native PostgreSQL — not recommended for production).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── File Storage — Hostinger (filesystem) ────────────────────────────────────
# Set this variable to activate filesystem storage mode.
# Must be an ABSOLUTE path (starts with /) OUTSIDE public_html so the
# directory is not web-accessible. The Express server serves uploaded files
# via authenticated API routes only.
# The uploads subdirectory is created automatically on first startup.
# Example: /home/u123456789/domains/yourdomain.com/private_uploads
# UPLOAD_ROOT=/home/u123456789/domains/yourdomain.com/private_uploads

# ── File Storage — Replit / GCS ───────────────────────────────────────────────
# Used when UPLOAD_ROOT is NOT set. Points to a GCS path for private uploads.
# Format: /bucket-name/optional-prefix
# PRIVATE_OBJECT_DIR=/your-gcs-bucket-name/private

# Comma-separated GCS path prefixes to search for public assets.
# Format: /bucket-name/prefix1, /bucket-name/prefix2
# PUBLIC_OBJECT_SEARCH_PATHS=/your-gcs-bucket-name/public

# GCS credentials — choose ONE of the two options below (GCS mode only):
# Option A: Path to a service-account JSON key file on disk.
# GOOGLE_APPLICATION_CREDENTIALS=/home/user/.config/gcs/service-account.json
# Option B: Inline JSON key (paste entire contents of JSON key on one line).
# GCS_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ── Logging ───────────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
